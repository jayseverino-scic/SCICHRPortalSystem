@model SCICHRPortal.Web.Models.ViewModels.Administration.EmployeeTimeLogViewModel
@{
    ViewData["Title"] = "Administration System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css">
    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" rel="stylesheet" />
    <link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
    <link href="~/lib/datatables/css/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/lib/datatables.net-select-dt/select.dataTables.css" rel="stylesheet" />
    <link href="~/lib/datatables-buttons/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/pages/admin/side-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/biometricslog.css" asp-append-version="true" />
    <link href="~/css/pages/grading/grading.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Inter&display=swap" rel="stylesheet" />
}
<div id="content-container" class="row">
    <div class="container col-md-12">
        <div class="left-header-container">
            <img class="icon" src="/images/administration/biometricsbig.png">
            <h1 class="title">Employee Biometrics Logs</h1>
        </div>
        <fieldset class="biometrics-section biometrics-filters" aria-labelledby="biometrics-filters-title">
            <legend id="biometrics-filters-title" class="biometrics-section-title">Filters</legend>
            <div class="form-group">
                <label for="start-date-filter" class="form-label">Start</label>
                <input id="start-date-filter" type="date" class="form-control">
            </div>
            <div class="form-group">
                <label for="end-date-filter" class="form-label">End</label>
                <input id="end-date-filter" type="date" class="form-control">
            </div>
            <div class="form-group">
                <label for="project" class="form-label">Project</label>
                <select id="project" class="form-control select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div>
                <button type="button" id="filter" class="btn btn-primary">Filter</button>
            </div>
            <div id="project-filter-status" class="biometrics-filter-status" role="status" aria-live="polite"></div>
        </fieldset>
        <fieldset class="biometrics-section biometrics-imports" aria-labelledby="biometrics-imports-title">
            <legend id="biometrics-imports-title" class="biometrics-section-title">Import logs</legend>
            <div>
                <button type="button" id="dbfilter" class="btn btn-primary">Import Records</button>
            </div>
            <div class="form-group">
                <label for="upload-file" class="form-label">Import Log File</label>
                <div class="biometrics-upload-control">
                    <input type="file" id="upload-file" class="form-control">
                    <button type="button" id="import" class="btn btn-primary">Import
                        <i class="fas fa-upload" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div id="biometrics-import-status" class="biometrics-import-status" role="status" aria-live="polite"></div>
        </fieldset>
        <div id="biometrics-page-status" role="status" aria-live="polite"></div>
        <table id="biometrics-log-grid" class="display" cellspacing="0" width="100%">
        </table>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/lib/toastr.js/toastr.min.js"></script>
    <script src="~/lib/moment.js/moment.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/printThis/printThis.min.js"></script>
    <script src="~/lib/handlebars.js/handlebars.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.js"></script>
    <script src="~/lib/datatables.net-select-dt/select.dataTables.js"></script>
    <script src="~/lib/datatables.net-select-dt/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-colvis/js/dataTables.colVis.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.print.min.js"></script>
    <script src="~/js/helpers/token-helper.js"></script>
    <script src="~/js/pages/administration/biometrics-log.js" asp-append-version="true"></script>
}
