@model string

<div class="tab-pane" id="jira-requests-panel" role="tabpanel" aria-labelledby="jira-requests-tab" tabindex="0"
     data-jira-endpoint="Authenticated/@Model/ApprovedRequests">
    <div data-jira-status role="status" aria-live="polite"></div>
    <div class="table-responsive" data-jira-table hidden>
        <table class="table table-striped align-middle">
            <thead class="table-success">
                <tr>
                    <th scope="col">Issue Key</th>
                    <th scope="col">Summary</th>
                    <th scope="col">Employee No.</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">From Date</th>
                    <th scope="col">From Time</th>
                    <th scope="col">To Date</th>
                    <th scope="col">To Time</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody data-jira-rows></tbody>
        </table>
    </div>
    <button type="button" class="btn btn-outline-secondary mt-2" data-jira-retry hidden>Retry</button>
    <button type="button" class="btn btn-outline-secondary" data-jira-more hidden>Load more</button>
</div>
