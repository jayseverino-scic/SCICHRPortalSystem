@{
    ViewData["Title"] = "Tardiness Summary";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" rel="stylesheet" />
    <link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
    <link href="~/lib/datatables-buttons/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="~/css/pages/admin/side-bar.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/admin/tardiness.css" rel="stylesheet" asp-append-version="true" />
}
<div id="content-container" class="row">
    <div class="container col-md-12 tardiness-page">
        <div class="left-header-container">
            <img class="icon" src="~/images/administration/tardinessbig.png" alt="" />
            <h1 class="title">Tardiness Summary</h1>
        </div>
        <p class="tardiness-description">View saved attendance for the selected period, including records with no late or undertime minutes.</p>
        <form id="tardiness-filter" aria-label="Tardiness filters">
            <fieldset class="tardiness-filters" aria-labelledby="tardiness-filters-title">
                <legend id="tardiness-filters-title">Filters</legend>
                <div class="form-group"><label for="tardiness-from" class="form-label">From</label><input id="tardiness-from" type="date" class="form-control" /></div>
                <div class="form-group"><label for="tardiness-to" class="form-label">To</label><input id="tardiness-to" type="date" class="form-control" /></div>
                <div class="form-group"><label for="tardiness-project" class="form-label">Project</label><select id="tardiness-project" class="form-control"><option value="0">All Projects</option></select></div>
                <div class="form-group tardiness-search"><label for="tardiness-search" class="form-label">Employee name or Employee Id</label><input id="tardiness-search" type="search" class="form-control" maxlength="200" placeholder="Search name or Employee Id" /></div>
                <div><button type="submit" class="btn btn-primary">Search</button></div>
            </fieldset>
        </form>
        <p id="tardiness-project-error" class="text-danger" role="alert" hidden></p>
        <p id="tardiness-status" role="status" aria-live="polite"></p>
        <p id="tardiness-warning" class="alert alert-warning" role="status" hidden></p>
        <table id="tardiness-grid" class="display" width="100%" aria-label="Saved attendance tardiness report">
            <thead><tr><th>Employee Id</th><th>Employee Name</th><th>Position</th><th>Department</th><th>Project</th><th>Attendance Date</th><th>Shift Start</th><th>Shift End</th><th>Time In</th><th>Time Out</th><th>Late Minutes</th><th>Undertime Minutes</th></tr></thead>
        </table>
    </div>
</div>
@section Scripts {
    <script src="~/lib/moment.js/moment.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatables-buttons/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
    <script src="~/js/pages/administration/tardiness.js" asp-append-version="true"></script>
}
