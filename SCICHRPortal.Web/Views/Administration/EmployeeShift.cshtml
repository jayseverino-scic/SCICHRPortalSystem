@{
    ViewData["Title"] = "Administration System";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css">
    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/select2-bootstrap-theme/select2-bootstrap.css" rel="stylesheet" />
    <link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" />
    <link href="~/lib/datatables/css/dataTables.bootstrap4.css" rel="stylesheet" />
    <link href="~/lib/datatables.net-select-dt/select.dataTables.css" rel="stylesheet" />
    <link href="~/lib/datatables-buttons/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/pages/admin/side-bar.css" asp-append-version="true" />
    <link href="~/css/pages/grading/grading.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/pages/admin/employeedhift.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css?family=Inter&display=swap" rel="stylesheet" />

}

    <div id="content-container" class="row">
    <div class="container col-md-12">
        <div class="left-header-container">
            <img class="icon" src="/images/administration/shiftassignmentbig.png">
                    <h1 class="title">Employee Shift Assignment</h1>
        </div>
        <form id="employee-shift-filter">
            <div class="form-group col-lg-2 col-sm-2">
                <label for="project">Project</label>
                <select id="project" class="form-control select" ></select>
            </div>
            <div class="form-group col-lg-2 col-sm-2">
                <label for="shift">Shift</label>
                <select id="shift" class="form-control select" ></select>
            </div>
            <div class="form-group col-lg-2 col-sm-2">
                <label for="status">Status</label>
                <select id="status" class="form-control select">
                    <option value="All">All</option>
                    <option value="Assigned">Assigned</option>
                    <option value="Unassigned">Unassigned</option>
                </select>
            </div>
            <div class="form-group col-lg-3 col-sm-3">
                <label for="assignment-shift">Schedule to assign</label>
                <select id="assignment-shift" class="form-control select"></select>
            </div>
            <div class="form-group col-lg-3 col-sm-3 pt-3">
                <button type="button" id="save" class="btn btn-primary mx-1" disabled>Save</button>
                <button type="button" id="cancel-pending" class="btn btn-default mx-1" disabled>Cancel pending changes</button>
            </div>
            <p id="employee-shift-pending" class="col-md-12" aria-live="polite" hidden></p>
            <p id="employee-shift-page-status" class="col-md-12" role="status" aria-live="polite"></p>
        </form>


        <table id="employee-shift-grid" class="display" cellspacing="0" width="100%" height="100%">
        </table>
    </div>
</div>


<div class="modal" id="effective-period-modal" tabindex="-1" role="dialog" aria-labelledby="effective-period-title" aria-hidden="true">
    <div class="modal-dialog" role="document"><div class="modal-content">
        <form id="effective-period-form">
            <div class="modal-header"><h4 class="modal-title" id="effective-period-title">Schedule effective period</h4></div>
            <div class="modal-body">
                <p id="effective-save-summary"></p>
                <p>Dates and times are in Philippine time (Asia/Manila).</p>
                <div class="form-group">
                    <label for="effective-start">Effective Start Date and Time</label>
                    <input id="effective-start" type="datetime-local" step="1" class="form-control" required />
                </div>
                <div class="checkbox"><label><input id="temporary-schedule" type="checkbox" /> Temporary schedule</label></div>
                <div id="effective-end-group" class="form-group" hidden>
                    <label for="effective-end">Effective End Date and Time</label>
                    <input id="effective-end" type="datetime-local" step="1" class="form-control" disabled />
                    <small>The previous schedule and flags return at this time.</small>
                </div>
                <p id="effective-error" class="text-danger" role="alert"></p>
            </div>
            <div class="modal-footer">
                <button id="effective-save-cancel" type="button" class="btn btn-default">Cancel</button>
                <button id="effective-save-confirm" type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div></div>
</div>
<div class="modal" id="shift-history-modal" tabindex="-1" role="dialog" aria-labelledby="shift-history-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document"><div class="modal-content">
        <div class="modal-header"><h4 id="shift-history-title" class="modal-title">Schedule history</h4></div>
        <div class="modal-body">
            <p>Philippine time. Each period ends immediately before its End time. Blank periods between assignments are unassigned.</p>
            <p id="shift-history-status" role="status"></p>
            <div class="table-responsive"><table class="table table-bordered">
                <thead><tr><th>Start</th><th>End</th><th>Schedule</th><th>Temporary</th><th>Flexible Shift</th><th>No Shift</th><th>No Break</th><th>Recorded by</th></tr></thead>
                <tbody id="shift-history-body"></tbody>
            </table></div>
        </div>
        <div class="modal-footer">
            <button id="shift-history-previous" type="button" class="btn btn-default">Previous</button>
            <button id="shift-history-next" type="button" class="btn btn-default">Next</button>
            <button id="shift-history-close" type="button" class="btn btn-default">Close</button>
        </div>
    </div></div>
</div>

@section Scripts {
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
    <script src="~/lib/toastr.js/toastr.min.js"></script>
    <script src="~/lib/moment.js/moment.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/underscore.js/underscore-min.js"></script>
    <script src="~/lib/printThis/printThis.min.js"></script>
    <script src="~/lib/handlebars.js/handlebars.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap4.js"></script>
    <script src="~/lib/datatables.net-select-dt/select.dataTables.js"></script>
    <script src="~/lib/datatables.net-select-dt/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-buttons/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables-colvis/js/dataTables.colVis.min.js"></script>
    <script src="~/lib/datatables-buttons/js/buttons.colVis.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.print.min.js"></script>
    <script src="~/js/helpers/token-helper.js"></script>
    <script src="~/js/pages/administration/employee-shift.js" asp-append-version="true"></script>
}
