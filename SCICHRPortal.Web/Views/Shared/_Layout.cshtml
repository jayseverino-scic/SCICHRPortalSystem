@using Microsoft.Extensions.Configuration
@using SCICHRPortal.Utility.Securities
@inject IConfiguration Configuration
@inherits AuthorizePage<TModel>
@{
    bool isAuthorize = await IsAuthorize();
    bool isAdmin = await HasRoleAsync("Administrator");
    bool hideSidebar = ViewBag.HideSidebar is bool hiddenSidebar && hiddenSidebar;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SCICHRPortal.Web</title>
    <link href="~/lib/font-awesome/css/all.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/limonte-sweetalert2/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SCICHRPortal.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/side-bar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin/_layout.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css?family=Inter&display=swap" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Busy Indicator -->
    <div id="busy-indicator-container" class="d-none">
        <img class="indicator-img-position" src="/images/loading_indicator.gif" />
    </div>

    <!-- Top Navbar -->
    <nav id="head-nav">

        <!-- Logo -->
        <a class="nav-logo-wrapper" href="/">
            <img src="/images/SCIC_TextLogoBelow.png" alt="Sta.Clara" id="nav-logo" />
            <h1 class="portal-title">SCIC Web Portal</h1>
        </a>

        <!-- Search — only when sidebar is visible -->
        @* @if (!hideSidebar)
        {
            <div class="nav-search-wrapper">
                <div class="nav-search-bar">
                    <i class="fas fa-search nav-search-icon"></i>
                    <input type="text" id="global-search" class="nav-search-input" placeholder="Search here" autocomplete="off" />
                </div>
            </div>
        }*@

        <!-- Right Actions -->
        <!-- FIX: changed nav-action-wrapper to nav-actions-wrapper to match _layout.css -->
        <div class="nav-actions-wrapper">

            <!-- Notification -->
            <div class="nav-action-item">
                <a href="#" id="notification-btn">
                    <i class="fas fa-bell nav-action-icon"></i>
                    <span class="nav-action-label">Notification</span>
                </a>
            </div>

            <!-- Logout -->
            <!-- FIX: id="logout" changed to id="nav-log-out" — consistent naming -->
            <div class="nav-action-item">
                <a href="#" id="nav-log-out">
                    <i class="fas fa-sign-out-alt nav-action-icon"></i>
                    <span class="nav-action-label">Logout</span>
                </a>
            </div>

            <!-- Username / Avatar -->
            <div class="nav-action-item">
                <div class="nav-avatar">
                    <img src="/images/default-avatar.png" alt="User" id="nav-avatar-img" />
                </div>
                <span class="nav-action-label" id="current-user">Username</span>
            </div>

        </div>
    </nav>

    <!-- Page Body -->
    <div class="page-body-wrapper">
        <input id="base-api-url" type="hidden" value="@Configuration["BaseApiUrl"]" />

        <div id="content-container" class="row">

            <!-- Sidebar -->
            @if (!hideSidebar)
            {
                <div class="nav-container" id="sidebar-container" tabindex="0">
                    <partial name="_AdministrationSidebar" />
                </div>
            }

            <!-- Main Content -->
            <main role="main" class="pb-3 @(hideSidebar ? "col-md-12 px-4" : "") main-wrapper">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- Footer -->
    <footer id="page-footer">
        <span>&copy; 2026 - SCIC</span>
        <span>&nbsp; @ViewBag.SystemSelected System - @DateTime.Today.ToShortDateString()</span>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/moment.js/moment.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.3/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/js/bootstrap.min.js"></script>
    <script src="~/lib/font-awesome/js/all.js"></script>
    <script src="~/lib/limonte-sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/helpers/cookie-helper.js"></script>
    <script src="~/js/helpers/api-helper.js"></script>
    <script src="~/js/helpers/number-helper.js"></script>
    <script src="~/js/helpers/form-helper.js"></script>
    <script src="~/js/helpers/date-helper.js"></script>
    <script src="~/js/helpers/string-helper.js"></script>
    <script src="~/lib/underscore.js/underscore-min.js"></script>

    @if (!hideSidebar)
    {
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/pages/admin/sidebar.js" asp-append-version="true"></script>
    }

    <script>
        // Navbar logout handler
        document.getElementById('nav-log-out')?.addEventListener('click', function (e) {
        e.preventDefault();
        const c = new CookieHelper();
        c.deleteAllContains('jsonWebToken');
        c.delete('refreshToken');
        window.location = '/Login/Index';
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
