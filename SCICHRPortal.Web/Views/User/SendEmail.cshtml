@model SCICHRPortal.Web.Models.ViewModels.Login.LoginViewModel

@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Login";
    Layout = "LoginLayout";

}

<!DOCTYPE html>
<html>
<head>
    <link href="~/css/pages/user/send-email.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.7.2/css/all.css" />
    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <input id="base-api-url" type="hidden" value="@Configuration["BaseApiUrl"]" />
    
    <!-- Busy Indicator -->
    <div id="busy-indicator-container" class="busy-indicator d-none">
        <img class="indicator-img-position" src="/images/loading_indicator.gif" />
    </div>

    <div class="forgot-page-container">

        <!-- Background -->
        <div class="scic-logo-wrapper">
            <div class="scic-logo-content">
                <div class="scic-logo-overflow">
                    <img alt="SCIC Logo" class="scic-logo-image" src="/images/SCIC-bground1.jpg" />
                </div>
                <div class="scic-logo-overlay"></div>
            </div>
        </div>

        <!-- Forgot Password Card -->
        <div id="reset-container" class="forgot-card">

            <div class="forgot-card-header">
                <h2 class="forgot-title">Forgot your password?</h2>
                <p class="forgot-subtitle">A code will be sent to your email.</p>
            </div>

            <p class="forgot-instruction">Enter your email to reset your password</p>

            <form id="forgot-password-form" novalidate>
                @Html.AntiForgeryToken()

                <div class="input-field-wrapper">
                    <label for="Email" class="sr-only">Email</label>
                    <input type="email" id="Email" name="Email" class="forgot-input lowercase" placeholder="Email Address" />
                    <span class="text-danger" id="email-error"></span>
                </div>

                <div class="forgot-btn-row">
                    <a href="/Login/Index" class="btn-cancel">Cancel</a>
                    <button type="submit" id="resetBtn" class="btn-submit">Submit</button>
                </div>
            </form>
        </div>

        <!-- Success Container -->
        <div id="success-container" class="success-overlay d-none">
            <div class="success-modal">
                <div class="success-icon-wrapper">
                    <i class="fas fa-envelope"></i>
                </div>
                <h3 class="success-title">Email Sent!</h3>
                <p class="success-message">
                    We have sent your temporary password, please check your email.
                    You can modify your temporary password on your profile.
                </p>
                <a href="/Login/Index" class="back-to-login">Back to Login</a>
            </div>
        </div>

    </div>

    


</body>
</html>

<div id="busy-indicator-container" class="d-none">
    <img class="indicator-img-position " src="/images/loading-indicator.gif">
</div>

@section Scripts {
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
<script src="~/lib/toastr.js/toastr.min.js"></script>
<script src="~/js/helpers/api-helper.js"></script>
<script src="~/js/helpers/form-helper.js"></script>
<script src="~/js/helpers/cookie-helper.js"></script>
<script src="~/js/pages/user/send-email.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/toastr.js/toastr.min.js" asp-append-version="true"></script>
<script src="~/js/pages/login/send-email.js" asp-append-version="true"></script>

    

}


