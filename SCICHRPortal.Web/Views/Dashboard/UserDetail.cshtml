@model SCICHRPortal.Web.Models.ViewModels.Administration.UserProfileViewModel
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/admin/side-bar.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/admin/users.css" rel="stylesheet" asp-append-version="true" />
}

<section class="users-page users-self-service" aria-labelledby="user-details-heading">
    <div class="users-header">
        <img class="icon" src="~/images/common/userrolebig.png" alt="" />
        <h1 id="user-details-heading">User Details</h1>
        <button type="button" class="users-menu-toggle" aria-label="Toggle navigation" aria-controls="admin-sidebar" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button>
    </div>
    <fieldset class="users-section users-page-actions" aria-labelledby="profile-actions-title">
        <legend id="profile-actions-title" class="users-section-title">Profile actions</legend>
        <button type="button" id="edit-user-detail" class="btn btn-primary" disabled>Edit Details</button>
        <p class="users-help">Keep your personal details and contact information up to date.</p>
    </fieldset>
    <div id="profile-status" class="users-page-status" role="status" aria-live="polite"></div>
    <button type="button" id="profile-retry" class="btn btn-default" hidden>Retry loading profile</button>
    <form id="user-detail-form" class="users-form" novalidate>
        <fieldset class="users-section users-form-section" aria-labelledby="profile-details-title">
            <legend id="profile-details-title" class="users-section-title">Personal information</legend>
            <div id="profile-form-status" class="users-form-status" role="alert" aria-live="assertive"></div>
            <div class="users-form-fields">
                <div class="form-group">
                    <label asp-for="FirstName">First Name</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" disabled />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MiddleName">Middle Name</label>
                    <input asp-for="MiddleName" class="form-control" autocomplete="additional-name" disabled />
                    <span asp-validation-for="MiddleName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName">Last Name</label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" disabled />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" autocomplete="email" disabled />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ContactNumber">Contact Number</label>
                    <input asp-for="ContactNumber" type="tel" class="form-control" autocomplete="tel" disabled />
                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                </div>
            </div>
            <div id="button-container" class="users-form-actions d-none">
                <button type="button" id="profile-cancel" class="btn btn-default">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </fieldset>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/toastr.js/toastr.min.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/user-detail.js" asp-append-version="true"></script>
}
