@model SCICHRPortal.Web.Models.ViewModels.Administration.UserPasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/admin/side-bar.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/admin/users.css" rel="stylesheet" asp-append-version="true" />
}

<section class="users-page users-self-service" aria-labelledby="change-password-heading">
    <div class="users-header">
        <img class="icon" src="~/images/common/changepasswordbig.png" alt="" />
        <h1 id="change-password-heading">Change Password</h1>
        <button type="button" class="users-menu-toggle" aria-label="Toggle navigation" aria-controls="admin-sidebar" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button>
    </div>
    <form id="change-password-form" class="users-form users-password-form" novalidate>
        <fieldset class="users-section users-form-section" aria-labelledby="password-security-title">
            <legend id="password-security-title" class="users-section-title">Account security</legend>
            <p class="users-help users-form-intro" id="password-help">Use 8–255 characters with at least one letter and one number. You’ll sign in again after changing your password.</p>
            <div id="password-form-status" class="users-form-status" role="alert" aria-live="assertive"></div>
            <div class="users-form-fields">
                <div class="form-group users-field-full">
                    <label asp-for="CurrentPassword">Current Password</label>
                    <input asp-for="CurrentPassword" id="current-password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password">New Password</label>
                    <input asp-for="Password" id="new-password" class="form-control" autocomplete="new-password" aria-describedby="password-help" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" id="confirm-password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <p class="d-none text-danger unmatched-password-validation" role="alert">New password and confirmation must match.</p>
            <div class="users-form-actions">
                <button type="submit" class="btn btn-primary">Change Password</button>
            </div>
        </fieldset>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/toastr.js/toastr.min.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/password.js" asp-append-version="true"></script>
}
