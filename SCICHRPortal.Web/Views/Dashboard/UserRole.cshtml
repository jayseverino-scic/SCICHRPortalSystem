@model SCICHRPortal.Web.Models.ViewModels.Admin.LookupsViewModel
@{
    ViewData["Title"] = "User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/datatables/css/jquery.dataTables.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/admin/side-bar.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pages/admin/users.css" rel="stylesheet" asp-append-version="true" />
}

<section class="users-page" aria-labelledby="user-roles-heading">
    <div class="users-header">
        <img class="icon" src="~/images/common/userrolebig.png" alt="" />
        <h1 id="user-roles-heading">User Roles</h1>
        <button type="button" class="users-menu-toggle" aria-label="Toggle navigation" aria-controls="admin-sidebar" aria-expanded="false"><i class="fas fa-bars" aria-hidden="true"></i></button>
    </div>
    <fieldset class="users-section users-page-actions" aria-labelledby="user-role-actions-title">
        <legend id="user-role-actions-title" class="users-section-title">Role actions</legend>
        <button type="button" class="btn btn-primary" id="add-button">New Role</button>
        <p class="users-help">Manage roles used by portal accounts. Built-in roles are protected.</p>
    </fieldset>
    <div class="users-table-wrapper">
        <table id="user-role-grid" class="display stripe" cellspacing="0" width="100%"></table>
    </div>
</section>

<div class="modal fade users-modal" id="user-role-modal" tabindex="-1" role="dialog"
     aria-labelledby="user-role-modal-title" aria-modal="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <form id="user-role-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title" id="user-role-modal-title">User Role</h2>
                </div>
                <div class="modal-body">
                    <div id="user-role-form-status" class="text-danger" role="alert" aria-live="assertive"></div>
                    <input name="roleId" id="RoleId" type="hidden" value="0" />
                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" data-bs-dismiss="modal" class="btn btn-default cancel-button">Cancel</button>
                    <button type="submit" id="payment-type-modal-btn" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/toastr.js/toastr.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.js" asp-append-version="true"></script>
    <script src="~/js/pages/dashboard/user-role.js" asp-append-version="true"></script>
}
